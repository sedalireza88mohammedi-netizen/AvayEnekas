<script>
    document.addEventListener('DOMContentLoaded', () => {
        const mobilePreviewToggles = document.querySelectorAll('.mobile-preview-toggle');

        mobilePreviewToggles.forEach(toggle => {
            toggle.addEventListener('click', () => {
                const parentBundle = toggle.closest('.bundle');
                const isCurrentlyOpen = toggle.classList.contains('open');

                // First, close any other open toggles and their parent bundles.
                mobilePreviewToggles.forEach(otherToggle => {
                    if (otherToggle !== toggle) {
                        otherToggle.classList.remove('open');
                        const otherParent = otherToggle.closest('.bundle');
                        if (otherParent) {
                            otherParent.classList.remove('open');
                        }
                    }
                });

                // Now, toggle the state of the clicked element and its parent.
                if (isCurrentlyOpen) {
                    toggle.classList.remove('open');
                    if (parentBundle) {
                        parentBundle.classList.remove('open');
                    }
                } else {
                    toggle.classList.add('open');
                    if (parentBundle) {
                        parentBundle.classList.add('open');
                    }
                }
            });
        });
    });
</script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const bundleInputs = document.querySelectorAll('input[name="bundle"]');
        const previewImages = document.querySelectorAll('.bundle-preview-image');

        function updatePreviewImage() {
            // Remove active class from all preview images
            previewImages.forEach(img => img.classList.remove('active'));

            // Find the checked bundle input
            const checkedInput = document.querySelector('input[name="bundle"]:checked');

            if (checkedInput) {
                const bundleId = checkedInput.getAttribute('data-bundle-id');

                // Add active class to the preview image with matching bundle-id
                const targetPreview = document.querySelector(`.bundle-preview-image[data-bundle-id="${bundleId}"]`);
                if (targetPreview) {
                    targetPreview.classList.add('active');
                }
            }
        }

        // Add event listeners to all bundle inputs
        bundleInputs.forEach(input => {
            input.addEventListener('change', updatePreviewImage);
        });

        // Initialize with the currently checked input
        updatePreviewImage();
    });
</script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const licenseInputs = document.querySelectorAll('input[name="license"]');
        const licenseLabels = document.querySelectorAll('.licenses-wrapper label.license-option');

        function updateActiveClasses() {
            // Remove active and main-active classes from all license labels
            licenseLabels.forEach(label => {
                label.classList.remove('active', 'main-active');
            });

            // Find the checked license input
            const checkedInput = document.querySelector('input[name="license"]:checked');

            if (checkedInput) {
                const checkedLabel = checkedInput.closest('label.license-option');

                if (checkedLabel) {
                    // Get all labels in the wrapper
                    const allLabels = Array.from(licenseLabels);
                    const checkedIndex = allLabels.indexOf(checkedLabel);

                    // Add active class to the checked label and all labels before it
                    for (let i = 0; i <= checkedIndex; i++) {
                        allLabels[i].classList.add('active');
                    }

                    // Add main-active class only to the selected label
                    checkedLabel.classList.add('main-active');
                }
            }
        }

        // Add event listeners to all license inputs
        licenseInputs.forEach(input => {
            input.addEventListener('change', updateActiveClasses);
        });

        // Initialize with the currently checked input
        updateActiveClasses();
    });
</script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const downloadLinks = document.querySelectorAll('.download-link');

        downloadLinks.forEach(link => {
            link.addEventListener('click', function (e) {
                e.preventDefault();

                const url = this.getAttribute('data-url');
                const loadingId = this.getAttribute('data-loading-id');
                const loadingMessage = document.getElementById(loadingId);

                if (!url) {
                    alert('لینک دانلود موجود نیست.');
                    return;
                }

                loadingMessage.style.display = 'block';

                this.classList.add('disabled');
                this.style.pointerEvents = 'none';
                this.style.opacity = '0.6';

                fetch(url, {
                    method: 'GET',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                })
                    .then(async response => {

                        const newTab = window.open(url, '_blank');

                        // Check if the new tab was blocked or failed to open
                        if (!newTab || newTab.closed || typeof newTab.closed === 'undefined') {
                            console.log('New tab was blocked or failed to open, trying fallback method');

                            // Fallback method: Create an iframe for download
                            const iframe = document.createElement('iframe');
                            iframe.style.display = 'none';
                            iframe.src = url;
                            document.body.appendChild(iframe);


                        }

                        // Hide loading message and reset button state after a short delay
                        setTimeout(() => {
                            loadingMessage.style.display = 'none';
                            this.classList.remove('disabled');
                            this.style.pointerEvents = 'auto';
                            this.style.opacity = '1';
                        }, 1500);


                    })
                    .catch(error => {
                        loadingMessage.style.display = 'none';
                        this.classList.remove('disabled');
                        this.style.pointerEvents = 'auto';
                        this.style.opacity = '1';

                        alert('مشکلی در دانلود فایل رخ داده است.');
                        console.error('Error:', error);
                    });
            });
        });
    });

</script>        
