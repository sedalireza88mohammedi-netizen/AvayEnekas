<script>
    document.addEventListener('DOMContentLoaded', async function() {
        const modal = document.getElementById('push-notification-modal');
        const allowBtn = document.getElementById('push-allow');
        const denyBtn = document.getElementById('push-deny');
        const COOKIE_NAME = 'push_notification_status';
        const DEBUG = window.PUSH_NOTIFICATIONS_DEBUG === true || window.PUSH_NOTIFICATIONS_DEBUG === 'true';
        
        // Initialize push manager and sync subscriptions
        // This ensures database is in sync with browser subscriptions
        if (window.pushManager) {
            try {
                await window.pushManager.init();
            } catch (error) {
                if (DEBUG) console.error('Error initializing push manager:', error);
            }
        }
        
        // Check if we should show the modal
        // IMPORTANT: Cookie is ONLY used to control popup display, NOT for subscription logic
        // Subscription is stored in database, Push sending uses database only
        async function shouldShowModal() {
            // Check cookie - if user dismissed/denied before, don't show again
            // Cookie only controls popup visibility, NOT subscription status
            const status = getCookie(COOKIE_NAME);
            if (status === 'denied' || status === 'dismissed') return false;
            
            // If permission is already denied, don't show
            if (Notification.permission === 'denied') return false;
            
            // If permission is granted, check if subscription exists in browser
            if (Notification.permission === 'granted') {
                try {
                    // Initialize push manager if not already done
                    if (!window.pushManager) {
                        window.pushManager = new PushNotificationManager();
                    }
                    
                    // Initialize to get service worker registration
                    await window.pushManager.init();
                    
                    if (window.pushManager.swRegistration) {
                        const subscription = await window.pushManager.swRegistration.pushManager.getSubscription();
                        // If subscription exists in browser, don't show modal
                        // Note: Even if cookie is deleted, if subscription exists in browser, 
                        // we don't need to show popup (subscription is still valid)
                        if (subscription) return false;
                    }
                } catch (e) {
                    // If check fails, show modal anyway
                    if (DEBUG) console.log('Error checking subscription:', e);
                }
            }
            
            return true;
        }
        
        // Show modal with delay
        shouldShowModal().then(shouldShow => {
            if (shouldShow) {
                setTimeout(() => {
                    modal.style.display = 'block';
                }, 3000); // Show after 3 seconds
            }
        });
        
        // Handle Allow
        allowBtn.addEventListener('click', async function() {
            const btnText = this.querySelector('span');
            const loader = this.querySelector('.btn-loader');
            
            // Check permission before proceeding
            const currentPermission = Notification.permission;
            if (DEBUG) console.log('Current notification permission:', currentPermission);
            
            if (currentPermission === 'denied') {
                setCookie(COOKIE_NAME, 'denied', 30);
                modal.style.display = 'none';
                
                // Get diagnostic info
                if (window.pushManager) {
                    window.pushManager.getDiagnosticInfo();
                }
                
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'info',
                        title: 'اعلان‌ها مسدود شده‌اند',
                        html: `
                            <p>برای دریافت اعلان‌ها، باید آن‌ها را در تنظیمات مرورگر فعال کنید:</p>
                            <ul style="text-align: right; direction: rtl; margin-top: 10px;">
                                <li><strong>Chrome/Edge:</strong> روی آیکون قفل در نوار آدرس کلیک کنید → Notifications → Allow</li>
                                <li><strong>Firefox:</strong> روی آیکون قفل در نوار آدرس کلیک کنید → Permissions → Notifications → Allow</li>
                                <li><strong>Safari:</strong> Preferences → Websites → Notifications → Allow</li>
                            </ul>
                            <p style="margin-top: 15px; font-size: 12px; color: #666;">پس از فعال‌سازی، صفحه را رفرش کنید.</p>
                        `,
                        confirmButtonText: 'متوجه شدم',
                        width: '500px'
                    });
                } else {
                    alert('اعلان‌ها مسدود شده‌اند. لطفاً آن‌ها را در تنظیمات مرورگر فعال کنید.');
                }
                return;
            }
            
            btnText.style.display = 'none';
            loader.style.display = 'block';
            this.disabled = true;
            
            try {
                if (!window.pushManager) {
                    console.error('Push Manager not loaded');
                    btnText.style.display = 'block';
                    loader.style.display = 'none';
                    this.disabled = false;
                    return;
                }
                
                await window.pushManager.init();
                const result = await window.pushManager.subscribe();
                
                if (result) {
                    // Set cookie ONLY to prevent showing popup again
                    // Subscription is stored in database, not cookie
                    setCookie(COOKIE_NAME, 'granted', 365); // 1 year
                    modal.style.display = 'none';
                    
                    // Optional: Show success toast
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'success',
                            title: 'عالی!',
                            text: 'از این به بعد اخبار مهم رو دریافت می‌کنی.',
                            timer: 3000,
                            showConfirmButton: false
                        });
                    }
                }
            } catch (error) {
                console.error('Subscription error:', error);
                
                // Get diagnostic info for debugging (only in debug mode)
                if (DEBUG && window.pushManager) {
                    const diagInfo = window.pushManager.getDiagnosticInfo();
                }
                
                // If denied, set cookie to not ask again for a while
                if (error.message.includes('denied') || error.message.includes('مسدود')) {
                    setCookie(COOKIE_NAME, 'denied', 30); // 30 days
                    modal.style.display = 'none';
                    
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'info',
                            title: 'اعلان‌ها مسدود شدند',
                            html: `
                                <p>برای فعال‌سازی اعلان‌ها:</p>
                                <ol style="text-align: right; direction: rtl; margin-top: 10px;">
                                    <li>روی آیکون قفل یا اطلاعات در نوار آدرس کلیک کنید</li>
                                    <li>Notifications را پیدا کنید</li>
                                    <li>Allow را انتخاب کنید</li>
                                    <li>صفحه را رفرش کنید</li>
                                </ol>
                            `,
                            confirmButtonText: 'متوجه شدم',
                            width: '450px'
                        });
                    } else {
                        alert('اعلان‌ها مسدود شدند. لطفاً آن‌ها را در تنظیمات مرورگر فعال کنید.');
                    }
                } else {
                    // Show error
                    btnText.style.display = 'block';
                    loader.style.display = 'none';
                    this.disabled = false;
                    
                    let errorMessage = 'خطا در فعال‌سازی اعلان‌ها. لطفاً دوباره تلاش کنید.';
                    if (error.message) {
                        errorMessage = error.message;
                    }
                    
                    if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'error',
                            title: 'خطا',
                            text: errorMessage,
                            confirmButtonText: 'باشه'
                        });
                    } else {
                        alert(errorMessage);
                    }
                }
            }
        });
        
        // Handle Deny
        denyBtn.addEventListener('click', function() {
            setCookie(COOKIE_NAME, 'dismissed', 30); // Ask again in 30 days
            modal.style.display = 'none';
        });
        
        // Cookie Helpers
        function setCookie(name, value, days) {
            let expires = "";
            if (days) {
                const date = new Date();
                date.setTime(date.getTime() + (days * 24 * 60 * 60 * 1000));
                expires = "; expires=" + date.toUTCString();
            }
            document.cookie = name + "=" + (value || "") + expires + "; path=/";
        }
        
        function getCookie(name) {
            const nameEQ = name + "=";
            const ca = document.cookie.split(';');
            for (let i = 0; i < ca.length; i++) {
                let c = ca[i];
                while (c.charAt(0) == ' ') c = c.substring(1, c.length);
                if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length, c.length);
            }
            return null;
        }
    });
</script>
