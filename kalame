                            notifWarning(data.message || 'خطایی رخ داد.');
                        }
                        return;
                    }

                    const favorited = !!data.favorited;
                    btn.classList.toggle('is-favorited', favorited);
                    btn.dataset.favorited = favorited ? '1' : '0';
                    btn.title = favorited ? 'حذف از علاقه‌مندی‌ها' : 'افزودن به علاقه‌مندی‌ها';
                    btn.querySelector('.fav-off').style.display = favorited ? 'none' : '';
                    btn.querySelector('.fav-on').style.display = favorited ? '' : 'none';

                    if (typeof notifSuccess === 'function') {
                        notifSuccess(data.message);
                    }
                } catch (e) {
                    if (typeof notifWarning === 'function') {
                        notifWarning('مشکلی پیش آمد. دوباره تلاش کنید.');
                    }
                } finally {
                    btn.disabled = false;
                }
            });
        })();
    </script>


    
    



